# Name of the cloud function.
export FUNCTION_NAME=lookup_service
# Source file for the cloud function.
export FUNCTION_SOURCE_FILE=main
# Entry point for the cloud function.
export FUNCTION_TARGET=main
# Port to run the function on.
export FUNCTION_PORT=8081
# Signature type of the function, can be one of http, event or cloudevent.
export FUNCTION_SIGNATURE_TYPE=http

# Environment, can be one of staging, prod.
export ENV=staging
# Topic name of the update snapshot data pubsub topic
export TOPIC_NAME_UPDATE_SNAPSHOT_DATA="projects/chromeos-prebuilts/topics/staging-update_snapshot_data"
# Topic name of the update binhost data pubsub topic
export TOPIC_NAME_UPDATE_BINHOST_DATA="projects/chromeos-prebuilts/topics/staging-update_binhost_data"